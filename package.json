{
  "name": "mechanism-canvas",
  "private": true,
  "version": "0.2.0",
  "description": "A shared organic chemistry workspace for learners and WebMCP agents.",
  "homepage": "https://mihirduvedi.github.io/mechanism-canvas/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mihirduvedi/mechanism-canvas.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify": "npm test && npm run build",
    "verify:submission": "npm run verify && node scripts/check-submission.mjs",
    "verify:release": "npm run verify:submission && node scripts/check-submission.mjs --release && node scripts/check-live-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
